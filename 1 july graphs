
import librosa
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import os

def detect_onsets_with_threshold(y, sr, threshold_db=-40, frame_length=2048, hop_length=512):
    rms = librosa.feature.rms(y=y, frame_length=frame_length, hop_length=hop_length)[0]
    rms_db = librosa.amplitude_to_db(rms, ref=np.max)
    times = librosa.frames_to_time(np.arange(len(rms_db)), sr=sr, hop_length=hop_length)

    onset_frames = librosa.onset.onset_detect(y=y, sr=sr, hop_length=hop_length, backtrack=True)
    onset_times = librosa.frames_to_time(onset_frames, sr=sr, hop_length=hop_length)

    filtered_onsets = []
    for t in onset_times:
        idx = np.argmin(np.abs(times - t))
        if rms_db[idx] >= threshold_db:
            filtered_onsets.append(t)
    return filtered_onsets

def seconds_to_smpte(seconds, fps=30, subframes=80):
    total_frames = seconds * fps
    frame_number = int(total_frames)
    fractional = total_frames - frame_number
    subframe_number = int(fractional * subframes)

    hours = frame_number // (fps * 60 * 60)
    remainder = frame_number % (fps * 60 * 60)
    minutes = remainder // (fps * 60)
    remainder = remainder % (fps * 60)
    secs = remainder // fps
    frames = remainder % fps

    return f"{hours:02d}:{minutes:02d}:{secs:02d}:{frames:02d}.{subframe_number:02d}"

def hz_to_note(freq):
    if freq <= 0 or np.isnan(freq):
        return "N/A"
    note_number = 12 * np.log2(freq / 440.0) + 69
    note_number = int(round(note_number))
    note_names = ['C', 'C#', 'D', 'D#', 'E', 'F',
                  'F#', 'G', 'G#', 'A', 'A#', 'B']
    octave = note_number // 12 - 1
    note = note_names[note_number % 12]
    return f"{note}{octave}"

# Load audio
filename = 'example.wav'
y, sr = librosa.load(filename, sr=None)

# Detect onsets and prepend 0.0
onsets = detect_onsets_with_threshold(y, sr)
onsets = [0.0] + onsets
audio_duration = librosa.get_duration(y=y, sr=sr)
onsets.append(audio_duration)

# Output folder
base_name = os.path.splitext(filename)[0]
output_folder = f"{base_name}_segment_graphics"
os.makedirs(output_folder, exist_ok=True)

# Segment analysis
segment_data = []
previous_rms_end = None  # To track last RMS value of previous segment
previous_last_f0 = None  # to store last pitch value of previous segment
for i in range(len(onsets) - 1):
    start = onsets[i]
    end = onsets[i + 1]
    start_sample = int(start * sr)
    end_sample = int(end * sr)
    segment = y[start_sample:end_sample]

    # Pitch detection
    f0 = librosa.yin(segment, fmin=librosa.note_to_hz('C2'),
                     fmax=librosa.note_to_hz('C7'), sr=sr)
    f0 = f0[~np.isnan(f0)] # ← This removes NaNs

    mean_freq = np.mean(f0) if len(f0) > 0 else 0
    
    segment_duration = end - start

    # Initialize text for swell detection box (empty if no swell)
    swell_segment_text = ""

    if i > 0 and i < len(onsets) - 2 and len(f0) > 1:
        pitch_diff = f0[-1] - f0[0]
        abs_pitch_diff = abs(pitch_diff)
        is_increasing = pitch_diff > 0
        is_decreasing = pitch_diff < 0

        prev_start = onsets[i - 1]
        prev_end = onsets[i]
        prev_segment = y[int(prev_start * sr):int(prev_end * sr)]
        prev_f0 = librosa.yin(prev_segment, fmin=librosa.note_to_hz('C2'),
                              fmax=librosa.note_to_hz('C7'), sr=sr)
        prev_f0 = prev_f0[~np.isnan(prev_f0)]
        prev_last_hz = prev_f0[-1] if len(prev_f0) > 0 else 0

        next_start = onsets[i + 1]
        next_end = onsets[i + 2]
        next_segment = y[int(next_start * sr):int(next_end * sr)]
        next_f0 = librosa.yin(next_segment, fmin=librosa.note_to_hz('C2'),
                              fmax=librosa.note_to_hz('C7'), sr=sr)
        next_f0 = next_f0[~np.isnan(next_f0)]
        next_first_hz = next_f0[0] if len(next_f0) > 0 else 0

        first_hz = f0[0]
        last_hz = f0[-1]

        if segment_duration < 10 and abs_pitch_diff > 5:
            if is_increasing and (first_hz >= prev_last_hz) and (last_hz <= next_first_hz):
                swell_segment_text = "Swell up segment"

            if is_decreasing and (first_hz >= prev_last_hz) and (last_hz <= next_first_hz):
                swell_segment_text = "Swell down segment"

    max_mean_deviation = 0
    if len(f0) > 0:
        max_mean_deviation = max(abs(max(f0) - mean_freq), abs(min(f0) - mean_freq))
    
    mean_note = hz_to_note(mean_freq)
    smpte_time = seconds_to_smpte(start)
    segment_data.append([smpte_time, mean_note])

    from scipy.stats import zscore

    outlier_text = ""
    f0_clean = f0.copy()
    if len(f0) > 4 and max_mean_deviation > 100:
        zscores = zscore(f0)
        outlier_indices = np.where(np.abs(zscores) > 2.5)[0]  # 2.5 std dev away is considered unusual
        if len(outlier_indices) > 0:
            # Remove outliers and recompute mean
            f0_no_outliers = np.delete(f0, outlier_indices)
            mean_freq_no_outliers = np.mean(f0_no_outliers) if len(f0_no_outliers) > 0 else 0
            mean_note_no_outliers = hz_to_note(mean_freq_no_outliers)
            outlier_text = f"Possible noise — MeanHz*: {int(round(mean_freq_no_outliers))} → {mean_note_no_outliers}"    
    # Difference from last segment's final Hz
    if len(f0) > 0 and previous_last_f0 is not None:
        hz_transition = abs(f0[0] - previous_last_f0)
        hz_transition = round(hz_transition, 2)
    else:
        hz_transition = 0.0  # or 'N/A' if you prefer

    

    # Store last Hz of current segment for next iteration
    previous_last_f0 = f0[-1] if len(f0) > 0 else previous_last_f0
    times = librosa.times_like(f0, sr=sr)
    times = times[:len(f0)]  # trim to match
    absolute_times = times + start

    mean_freq = np.mean(f0) if len(f0) > 0 else 0
    mean_note = hz_to_note(mean_freq)
    smpte_time = seconds_to_smpte(start)
    segment_data.append([smpte_time, mean_note])

    # Format Hz values (integers, 11 per line)
    hz_int_values = [str(int(round(val))) for val in f0]
    grouped_lines = []
    for j in range(0, len(hz_int_values), 11):
        line = ", ".join(hz_int_values[j:j+11])
        grouped_lines.append(line)
    wrapped_text = "\n".join(grouped_lines)

        # Compute RMS for loudness
    rms = librosa.feature.rms(y=segment, frame_length=2048, hop_length=512)[0]
    # RMS transition from previous segment
    if len(rms) > 0 and previous_rms_end is not None:
        rms_transition = abs(rms[0] - previous_rms_end)
        rms_transition = round(rms_transition, 4)
    else:
        rms_transition = 0.0  # or 'N/A' if you prefer

    # Store this segment's RMS end value
    previous_rms_end = rms[-1] if len(rms) > 0 else previous_rms_end
    rms_times = librosa.frames_to_time(np.arange(len(rms)), sr=sr, hop_length=512)
    rms_times = rms_times + start  # shift relative to full audio

    # Create 2 subplots: pitch (top), loudness (bottom)
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 8), sharex=True, gridspec_kw={'height_ratios': [2, 1]})
    
    # Pitch plot
    ax1.plot(absolute_times, f0, marker='o', linestyle='-', color='b')
    ax1.set_title(f"Segment {i} — {mean_note} — SMPTE: {smpte_time}")
    ax1.set_ylabel("Pitch (Hz)")
    ax1.grid(True)

    # Loudness plot
    ax2.plot(rms_times, rms, color='orange')
    ax2.set_ylabel("Loudness (RMS)")
    ax2.set_xlabel("Time (seconds)")
    ax2.grid(True)

    # Add text box with Hz values
    fig.text(0.72, 0.8, wrapped_text, fontsize=9, va='center', ha='left',
             bbox=dict(facecolor='white', edgecolor='gray', boxstyle='round,pad=0.5'),
             transform=fig.transFigure, clip_on=False)
    # RMS start and end values
    rms_start = round(rms[0], 2) if len(rms) > 0 else 0.0
    rms_end = round(rms[-1], 2) if len(rms) > 0 else 0.0
    rms_text = f"RMS Start: {rms_start}\nRMS End: {rms_end}"

    # Add text box with RMS start and end
    fig.text(0.72, 0.3, rms_text, fontsize=9, va='center', ha='left',
         bbox=dict(facecolor='white', edgecolor='gray', boxstyle='round,pad=0.5'),
         transform=fig.transFigure, clip_on=False)
   
    # Add text box with mean RMS value
    mean_rms = round(np.mean(rms), 4) if len(rms) > 0 else 0.0
    mean_rms_text = f"Mean RMS: {mean_rms}"

    fig.text(0.72, 0.2, mean_rms_text, fontsize=9, va='center', ha='left',
         bbox=dict(facecolor='white', edgecolor='gray', boxstyle='round,pad=0.5'),
         transform=fig.transFigure, clip_on=False)
    
    # Add text box with mean frequency in Hz
    mean_hz = round(mean_freq, 2)
    mean_hz_text = f"Mean Hz: {mean_hz}"

    fig.text(0.72, 0.7, mean_hz_text, fontsize=9, va='center', ha='left',
         bbox=dict(facecolor='white', edgecolor='gray', boxstyle='round,pad=0.5'),
         transform=fig.transFigure, clip_on=False)
   
    # Add text box with maximum mean deviation
    if len(f0) > 0:
       min_hz = np.min(f0)
       max_hz = np.max(f0)
       deviation = max(abs(min_hz - mean_freq), abs(max_hz - mean_freq))
       deviation = round(deviation, 2)
    else:
       deviation = 0.0

    deviation_text = f"Max Mean Deviation: {deviation} Hz"

    fig.text(0.72, 0.6, deviation_text, fontsize=9, va='center', ha='left',
           bbox=dict(facecolor='white', edgecolor='gray', boxstyle='round,pad=0.5'),
           transform=fig.transFigure, clip_on=False)
    
    # Add text box with Hz transition from previous segment
    transition_text = f"Transition ΔHz: {hz_transition}"

    fig.text(0.72, 0.5, transition_text, fontsize=9, va='center', ha='left',
             bbox=dict(facecolor='white', edgecolor='gray', boxstyle='round,pad=0.5'),
             transform=fig.transFigure, clip_on=False)

    # Add text box with RMS transition from previous segment
    rms_transition_text = f"Transition ΔRMS: {rms_transition}"

    fig.text(0.72, 0.1, rms_transition_text, fontsize=9, va='center', ha='left',
             bbox=dict(facecolor='white', edgecolor='gray', boxstyle='round,pad=0.5'),
             transform=fig.transFigure, clip_on=False)  
    
    # Add text box if outlier was found
    if outlier_text:
        fig.text(0.72, 0.4, outlier_text, fontsize=9, va='center', ha='left', color='red',
                 bbox=dict(facecolor='white', edgecolor='gray', boxstyle='round,pad=0.5'),
                 transform=fig.transFigure, clip_on=False)
    
    if swell_segment_text: 
        fig.text(0.72, 0.45, swell_segment_text, fontsize=10, color='red', va='center', ha='left',
                 bbox=dict(facecolor='white', edgecolor='red', boxstyle='round,pad=0.5'),
                 transform=fig.transFigure, clip_on=False)

    # Adjust layout and save
    plt.subplots_adjust(right=0.7, hspace=0.3)
    safe_note = mean_note.replace("#", "s")
    image_filename = f"segment_{i}_{safe_note}.png"
    filepath = os.path.join(output_folder, image_filename)
    plt.savefig(filepath)
    plt.close()
   
# Output table to terminal
df = pd.DataFrame(segment_data, columns=["Onset (SMPTE)", "Mean Note"])
print("\nSegment Summary:")
print(df.to_string(index=True))
print(f"\nAll segment graphs saved to: {output_folder}")
