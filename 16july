        fig.text(0.75, 0.60, "Fade out", fontsize=9, va='center', ha='left',
             bbox=dict(facecolor='purple', edgecolor='gray', boxstyle='round,pad=0.5'),
             transform=fig.transFigure, clip_on=False)         


    # Add text box with Note_start or end
    if note_edge_label_flag == "Note_start":
        fig.text(0.75, 0.68, "Note Start", fontsize=9, va='center', ha='left',
             bbox=dict(facecolor='yellow', edgecolor='gray', boxstyle='round,pad=0.5'),
             transform=fig.transFigure, clip_on=False)
    if note_edge_label_flag == "Note_end":
        fig.text(0.75, 0.68, "Note End", fontsize=9, va='center', ha='left',
             bbox=dict(facecolor='yellow', edgecolor='gray', boxstyle='round,pad=0.5'),
             transform=fig.transFigure, clip_on=False)


    # --- Save Plot ---
    png_path = os.path.join(segment_png_folder, f"segment_{i:03d}.png")
    plt.savefig(png_path)
    plt.close()
