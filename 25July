import csv
csv2_path = os.path.join(output_folder, f"{base_name} csv2.csv")
def append_group(output_rows, current_group, segment_data, note_no, previous_note, next_note):
    first_idx = int(current_group["segments"][0])
    last_idx = int(current_group["segments"][-1])
    first_seg = segment_data[first_idx]
    last_seg = segment_data[last_idx]

    big_swell = "Yes" if any(
        segment_data[int(s)]["swell"] != "-" and segment_data[int(s)]["Duration"] > 0.2
        for s in current_group["segments"]
    ) else "-"

    # Updated swell_note condition: ALL segments have swell AND any Transition ARMS < 0.02
    swell_note = "Yes" if (
        all(segment_data[int(s)]["swell"] != "-" for s in current_group["segments"])
    ) else "-"

    swell_up_beginning = "Yes" if first_seg["swell"] == "Swell_Up" else "-"
    swell_down_beginning = "Yes" if first_seg["swell"] == "Swell_Down" else "-"
    swell_up_end = "Yes" if last_seg["swell"] == "Swell_Up" else "-"
    swell_down_end = "Yes" if last_seg["swell"] == "Swell_Down" else "-"

    fade_in = "Yes" if any("Fade_in" in segment_data[int(s)]["Fade"] for s in current_group["segments"]) else "-"
    fade_out = "Yes" if any("Fade_out" in segment_data[int(s)]["Fade"] for s in current_group["segments"]) else "-"
    note_start = "Yes" if any("Note_start" in segment_data[int(s)]["note_edge_label"] for s in current_group["segments"]) else "-"
    note_end = "Yes" if any("Note_end" in segment_data[int(s)]["note_edge_label"] for s in current_group["segments"]) else "-"

    transition = "-"
    if current_group["note"] == "T" or swell_note == "Yes":
        if previous_note != "-" and next_note != "-":
            transition = f"{previous_note} -> {next_note}"

    row = {
        "Note_no": note_no,
        "Segments": ",".join(current_group["segments"]),
        "Smpte_time": current_group["smpte_time"],
        "Duration": round(current_group["duration"], 3),
        "Note": current_group["note"],
        "Big_swell": big_swell,
        "Swell_note": swell_note,
        "Swell up Beginning": swell_up_beginning,
        "Swell down Beginning": swell_down_beginning,
        "Swell up End": swell_up_end,
        "Swell down End": swell_down_end,
        "Fade in": fade_in,
        "Fade out": fade_out,
        "Note start": note_start,
        "Note end": note_end,
        "Transition": transition,
    }
    output_rows.append(row)

def merge_segments(segment_data, output_csv_path):
    output_rows = []
    current_group = {
        "segments": [],
        "smpte_time": None,
        "duration": 0.0,
        "note": None,
    }
    note_no = 0
    notes_sequence = []

    # First pass to collect all group notes (for transition context)
    for idx, segment in enumerate(segment_data):
        note = segment["Note"]
        can_merge = segment["Transition"] == "-"

        should_merge = (
            current_group["segments"] and
            note == current_group["note"] and
            can_merge
        )

        if not should_merge and current_group["segments"]:
            notes_sequence.append(current_group["note"])
            current_group = {
                "segments": [],
                "smpte_time": None,
                "duration": 0.0,
                "note": None,
            }

        if not current_group["segments"]:
            current_group["smpte_time"] = segment["Smpte_time"]
            current_group["note"] = note

        current_group["segments"].append(str(idx))
        current_group["duration"] += segment["Duration"]

    if current_group["segments"]:
        notes_sequence.append(current_group["note"])

    # Second pass to build rows with transition labels
    current_group = {
        "segments": [],
        "smpte_time": None,
        "duration": 0.0,
        "note": None,
    }
    note_idx = 0
    group_index = 0

    for idx, segment in enumerate(segment_data):
        note = segment["Note"]
        can_merge = segment["Transition"] == "-"

        should_merge = (
            current_group["segments"] and
            note == current_group["note"] and
            can_merge
        )

        if not should_merge and current_group["segments"]:
            prev_note = notes_sequence[group_index - 1] if group_index - 1 >= 0 else "-"
            next_note = notes_sequence[group_index + 1] if group_index + 1 < len(notes_sequence) else "-"
            append_group(output_rows, current_group, segment_data, note_idx, prev_note, next_note)
            note_idx += 1
            group_index += 1
            current_group = {
                "segments": [],
                "smpte_time": None,
                "duration": 0.0,
                "note": None,
            }

        if not current_group["segments"]:
            current_group["smpte_time"] = segment["Smpte_time"]
            current_group["note"] = note

        current_group["segments"].append(str(idx))
        current_group["duration"] += segment["Duration"]

    # Final group
    if current_group["segments"]:
        prev_note = notes_sequence[group_index - 1] if group_index - 1 >= 0 else "-"
        next_note = "-"
        append_group(output_rows, current_group, segment_data, note_idx, prev_note, next_note)

    # Write CSV
    with open(output_csv_path, mode="w", newline="") as csv_file:
        fieldnames = [
            "Note_no", "Segments", "Smpte_time", "Duration", "Note",
            "Big_swell", "Swell_note",
            "Swell up Beginning", "Swell down Beginning",
            "Swell up End", "Swell down End",
            "Fade in", "Fade out",
            "Note start", "Note end",
            "Transition"
        ]
        writer = csv.DictWriter(csv_file, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(output_rows)

    print(f"CSV saved to: {output_csv_path}")

