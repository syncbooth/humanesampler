    ax2.grid(True)

    jump_threshold = 20  # Threshold for detecting pitch jumps

    # If noise jumps exist, use cleaned pitch; else use original pitch
    if noise_jump_indices:
        pitch_data = f0_clean
        time_data = f0_time_clean
    else:
        pitch_data = f0
        time_data = f0_time

    # Calculate jump points based on pitch jumps in cleaned pitch data
    jump_points = [0]
    for k in range(1, len(pitch_data)):
        if abs(pitch_data[k] - pitch_data[k - 1]) >= jump_threshold:
            jump_points.append(k)
    jump_points.append(len(pitch_data))

    # Build subsegments info dynamically based on jump points
    subsegments = []
    for j in range(len(jump_points) - 1):
        start_idx = jump_points[j]
        end_idx = jump_points[j + 1]
        segment_vals = pitch_data[start_idx:end_idx]
        if len(segment_vals) == 0:
            continue
        mean_hz = np.mean(segment_vals)
        length = end_idx - start_idx
        percent = 100 * length / len(pitch_data)
        subsegments.append({
            "name": f"Subseg {j}",
            "mean_hz": mean_hz,
            "percent": percent,
            "start_idx": start_idx,
            "end_idx": end_idx
        })

    # Plot subsegments with colored spans and mean lines
    for j, sub in enumerate(subsegments):
        start_idx = sub["start_idx"]
        end_idx = sub["end_idx"]

        # Safety check in case indices exceed time_data length
        if start_idx >= len(time_data) or end_idx > len(time_data):
            continue

        t_start = time_data[start_idx]
        t_end = time_data[end_idx - 1]

        # Colored background for subsegment
        ax2.axvspan(t_start, t_end, color=plt.cm.tab20(j % 20), alpha=0.3)

        # Horizontal line at mean pitch
        ax2.hlines(sub["mean_hz"], t_start, t_end, colors="black", linewidth=1)

        # Fixed y-axis range and label placement in the middle vertically
        ax2.set_ylim(0, 1)
        y_center = 0.5

        # Text label with name, percentage, and mean Hz
        ax2.text(
            (t_start + t_end) / 2,
            y_center,
            f"{sub['name']}\n{sub['percent']:.1f}%\n{sub['mean_hz']:.1f} Hz",
            ha="center", va="center",
            fontsize=6,
            bbox=dict(boxstyle="round", facecolor="white", alpha=0.8)
        )

    # Set x limits to match pitch timeline
    ax2.set_xlim([time_data[0], time_data[-1]])

    # --- Data Text Box ---
    # --- Text Box Info for Segment ---
    segment_info = segment_data[i]

    def safe_float(val, default="-"):
        try:
            return f"{float(val):.2f}"
        except (ValueError, TypeError):
            return default
    import textwrap

    # Wrap Hz values to avoid overflow
    hz_values_raw = segment_info.get("Hz values", "")
    hz_values_list = hz_values_raw.replace(',', ' ').split()
    if len(hz_values_list) > 300:
        wrapped_hz_values = "Too many values"  # Too many values, show empty
    else:
        wrapped_hz_values = textwrap.fill(hz_values_raw, width=50) 
    text_lines = [
        "Hz values:",
        wrapped_hz_values,
         "",
        f"Hz Transition: {segment_info.get('hz_transition', '')}",
        f"Mean Freq: {safe_float(segment_info.get('Mean_freq'), ' Hz')}",
        "",
        "",
        f"Swell Tendency: {segment_info.get('swell_tendency', '')}",
        f"Swell: {segment_info.get('swell', '')}",
        "",
        "",
        f"Mean RMS: {segment_info.get('Mean_rms', 0):.4f}",
        f"RMS Start: {segment_info.get('rms_start', 0):.4f}",
        f"RMS End: {segment_info.get('rms_end', 0):.4f}",
        f"RMS Transition: {segment_info.get('rms_transition', 0):.4f}",
    ]

    text_str = "\n".join(text_lines)

    # Add text box to the right side of the figure (outside the subplots)
    fig.text(0.76, 0.5, text_str, fontsize=9,
            va='center', ha='left', wrap=True,
            bbox=dict(facecolor='whitesmoke', alpha=0.8, boxstyle='round'))
    
    # --- RMS of current segment ---Bottom graph
    ax3.plot(rms_time, rms, label="RMS", color="orange")
    ax3.set_ylabel("Loudness")
    ax3.set_title("")
    ax3.grid(True)

