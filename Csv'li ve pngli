        next_rms_start = next_rms[0] if len(next_rms) > 0 else 0.0

        if (rms_start < 0.01 and mean_rms > 0.01 and
            prev_rms_end < 0.01 and next_rms_start >= rms_end):
            is_fade_in = True

    # Fade-out detection
    is_fade_out = False
    if i > 0 and i < len(onsets) - 2:
        next_segment = y[int(onsets[i + 1] * sr):int(onsets[i + 2] * sr)]
        next_rms = librosa.feature.rms(y=next_segment, frame_length=2048, hop_length=512)[0]
        next_rms_start = next_rms[0] if len(next_rms) > 0 else 0.0

        if (
            rms_end < 0.01 and
            mean_rms > 0.01 and
            next_rms_start < 0.01 and
            prev_rms_end >= rms_start
        ):
            is_fade_out = True
    elif i == len(onsets) - 2:
        if rms_end < 0.01 and mean_rms > 0.01:
            is_fade_out = True      

    # Silence condition
    if mean_rms < 0.005:
        mean_note = "S"
        mean_freq_str = "-"
        noise_label = "-"
    else:
        mean_freq_str = f"{mean_freq:.2f}"

    # SMPTE
    start_smpte = seconds_to_smpte(start)
    end_smpte = seconds_to_smpte(end)

    # Transition label
    transition_label = "Transition" if is_transition else "-"

    # Fade label logic (merged column)
    if is_fade_in and is_fade_out:
        fade_label = "Fade_in + Fade_out"
    elif is_fade_in:
        fade_label = "Fade_in"
    elif is_fade_out:
        fade_label = "Fade_out"
    else:
        fade_label = "-"

    # Adjust values for Transition
    if transition_label == "Transition":
        mean_note = "T"
        mean_freq_str = "-"
        max_dev_str = "-"
        delta_hz_str = "-"
    else:
        max_dev_str = "-" if mean_note in ["S", "T"] else f"{round(max_dev, 2)}"
        delta_hz_str = "-" if mean_note in ["S", "T"] else f"{round(delta_hz, 2)}"

    # Apply pitch correction
    if corrected_pitch and mean_note != "S":
        if transition_label == "-":
            mean_note = corrected_pitch
            noise_label = "Pitch corrected"

    # Detect Note_start or Note_end
    note_group_text = detect_note_edge_by_jump(f0, rms)

    # CSV tweaks
    if mean_note == "S" or transition_label == "Transition" or noise_label == "Pitch corrected":
        swell_label = "-"
    if i > 0:
        prev_note_group = csv_rows[-1][-1]  # last column of previous row
        if prev_note_group == "Note_start":
            fade_label = "-"

    # Append CSV row
    csv_rows.append([
        i,                           # Seg_No
        mean_note,                  # Pitch
        f"{duration:.2f}",          # Duration
        start_smpte,                # Start_Time
        end_smpte,                  # End_Time
        mean_freq_str,              # Mean_Hz
        max_dev_str,                # Max_Hz_Dev
        delta_hz_str,               # Transition_ΔHz
        swell_tendency,             # Swell_Ten
        swell_label,                # Swell
        round(mean_rms, 6),         # Mean_RMS
        round(rms_start, 6),        # RMS_Start
        round(rms_end, 6),          # RMS_End
        round(delta_rms, 6),        # Transition_ΔRMS
        fade_label,                 # Fade (merged)
        transition_label,           # Is_Transition
        noise_label,                # Noise
        note_group_text             # Start_Stop
    ])

# Write CSV
with open(csv_output_path, mode='w', newline='') as csv_file:
    csv_writer = csv.writer(csv_file)
    csv_writer.writerow([
        "Seg_No",
        "Pitch",
        "Duration",
        "Start_Time",
        "End_Time",
        "Mean_Hz",
        "Max_Hz_Dev",
        "Transition_ΔHz",
        "Swell_Ten",
        "Swell",
        "Mean_RMS",
        "RMS_Start",
        "RMS_End",
        "Transition_ΔRMS",
        "Fade",              # ✅ Merged column
        "Is_Transition",
        "Noise",
        "Start_Stop"
    ])
    csv_writer.writerows(csv_rows)

print(f"CSV summary saved to: {csv_output_path}")
